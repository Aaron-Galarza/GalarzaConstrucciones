---
import '@fontsource-variable/archivo';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { buildSEOTags } from '../lib/seo';
import type { SEOProps } from '../lib/seo';

interface Props extends SEOProps {
  /** Schemas JSON-LD específicos de la página (ya serializados por lib/schema). */
  schemas?: ReturnType<typeof JSON.parse>[];
  /** Alias para SLOT del main */
  children?: any;
}

const {
  title,
  description,
  path,
  type,
  image,
  robots,
  schemas = [],
} = Astro.props;

const seo = buildSEOTags({ title, description, path, type, image, robots });

// Analítica: se activa únicamente cuando existe la variable de entorno
// PUBLIC_GA_MEASUREMENT_ID. Sin ID configurado, no se carga JavaScript.
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID as string | undefined;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a1e2c" />

    {
      seo.map((t) => (
        t.tag === 'title' ? <title>{t.children}</title> : <meta {...t.attrs} />
      ))
    }

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    {
      schemas.length > 0 && (
        <script is:inline set:html={JSON.stringify(schemas.length === 1 ? schemas[0] : schemas).replace(/</g, '\\u003c')} type="application/ld+json"></script>
      )
    }

    {
      gaId && (
        <>
          <script is:inline>
            {`window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', '${gaId}', { anonymize_ip: true });`}
          </script>
          <script is:inline src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} async></script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>