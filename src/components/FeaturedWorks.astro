---
// Obras destacadas de la home: lee la colección `obras` y muestra las que
// están marcadas como featured, ordenadas por `order`.

import { getCollection } from 'astro:content';
import BlueprintCard from './BlueprintCard.astro';
import SectionHeader from './SectionHeader.astro';
import { obraCover } from '../lib/obras';

const obras = (await getCollection('obras'))
  .filter((obra) => obra.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="section works">
  <div class="shell">
    <SectionHeader
      annotation="Obras destacadas"
      title="Proyectos reales, ejecutados y supervisados."
      lead="Una selección de obras que muestran escala, complejidad y resolución técnica."
    />

    <div class="works-grid">
      {
        obras.map((obra, i) => {
          const cover = obraCover(obra);
          return (
            <BlueprintCard
              code={`O-${String(i + 1).padStart(2, '0')}`}
              title={obra.data.title}
              href={`/obras/${obra.id}/`}
              category={obra.data.category}
              location={obra.data.location}
              image={cover?.src}
              imageAlt={cover?.alt}
            />
          );
        })
      }
    </div>

    <p class="works-more">
      <a href="/obras/" class="btn btn--ghost">Ver todas las obras</a>
    </p>
  </div>
</section>

<style>
  .works-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .works-more {
    margin-top: var(--space-lg);
  }

  @media (max-width: 1024px) {
    .works-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .works-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
