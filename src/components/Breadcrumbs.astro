---
// Migas de pan: dan contexto y enlaces internos en páginas interiores.

interface Props {
  items: { name: string; path: string }[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Ruta actual">
  <ol>
    {
      items.map((item, i) => (
        <li>
          {i === items.length - 1 ? (
            <span aria-current="page">{item.name}</span>
          ) : (
            <a href={item.path}>{item.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    margin: 0 0 var(--space-md);
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  .breadcrumbs li {
    margin: 0;
  }

  .breadcrumbs li:not(:last-child)::after {
    content: '/';
    margin-left: 0.5rem;
    color: var(--color-muted);
  }

  .breadcrumbs a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-navy);
    text-decoration: underline;
  }

  .breadcrumbs [aria-current='page'] {
    color: var(--color-ink);
    font-weight: 600;
  }
</style>