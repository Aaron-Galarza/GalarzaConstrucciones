---
import { SERVICES } from '../lib/company';

interface Props {
  /** Texto del encabezado de la sección; se reutiliza en /servicios/. */
  heading?: string;
}

const { heading = 'Servicios que cubren todo el ciclo de la obra' } = Astro.props;
---

<section class="section services">
  <div class="shell">
    <header class="section-head">
      <p class="annotation">Servicios</p>
      <h2>{heading}</h2>
      <p class="lead">
        Desde la obra nueva hasta la intervención sobre una construcción que ya
        existe: cada servicio se adapta al contexto del proyecto.
      </p>
    </header>

    <div class="services-grid">
      {
        SERVICES.map((service) => (
          <a href={service.link} class="card card--link service-card">
            <h3 class="service-title">{service.title}</h3>
            <p class="service-text">{service.short}</p>
            <span class="service-link">Conocer el servicio</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .service-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-md);
    background: var(--color-surface);
  }

  .service-title {
    font-size: 1.15rem;
    margin-bottom: var(--space-sm);
  }

  .service-text {
    color: var(--color-muted);
    font-size: var(--text-sm);
    flex: 1;
  }

  .service-link {
    display: inline-block;
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-navy);
    text-decoration: underline;
    text-decoration-color: var(--color-cyan);
    text-underline-offset: 3px;
  }

  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>