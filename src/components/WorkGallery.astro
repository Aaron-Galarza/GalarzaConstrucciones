---
// Galería de fotografías de obra o de servicio. Cada ítem referencia una
// imagen de la carpeta pública (`src` absoluta), con alt y epígrafe opcional.

interface GalleryItem {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  items: GalleryItem[];
  /** Epígrafe de sección, ej. "Registro fotográfico de la obra". */
  heading?: string;
}

const { items, heading = 'Registro fotográfico' } = Astro.props;
---

<section class="work-gallery">
  {
    heading && (
      <header class="gallery-head">
        <h2>{heading}</h2>
      </header>
    )
  }

  <figure class="gallery-item">
    <img
      src={items[0]?.src}
      alt={items[0]?.alt}
      width="1600"
      height="1200"
      loading="lazy"
      decoding="async"
    />
    {
      items[0]?.caption && (
        <figcaption>
          <span class="gallery-index">01</span>
          {items[0]?.caption}
        </figcaption>
      )
    }
  </figure>

  {
    items.length > 1 && (
      <div class="gallery-grid">
        {
          items.slice(1).map((item, i) => (
            <figure class="gallery-item">
              <img
                src={item.src}
                alt={item.alt}
                width="1600"
                height="1200"
                loading="lazy"
                decoding="async"
              />
              {
                item.caption && (
                  <figcaption>
                    <span class="gallery-index">
                      {String(i + 2).padStart(2, '0')}
                    </span>
                    {item.caption}
                  </figcaption>
                )
              }
            </figure>
          ))
        }
      </div>
    )
  }
</section>

<style>
  .work-gallery {
    max-width: var(--container);
    margin-bottom: var(--space-xl);
  }

  .gallery-head {
    margin-bottom: var(--space-md);
  }

  .gallery-head h2 {
    font-size: 1.4rem;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.5rem;
  }

  .gallery-item {
    margin: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }

  .gallery-grid .gallery-item {
    margin: 0;
  }

  .gallery-item img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-bottom: 1px solid var(--color-line);
  }

  .gallery-item:first-child img {
    aspect-ratio: 16 / 9;
  }

  .gallery-item figcaption {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    font-size: var(--text-sm);
    font-style: normal;
    color: var(--color-ink);
  }

  .gallery-index {
    font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--color-cyan);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  @media (max-width: 720px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .gallery-item:first-child img {
      aspect-ratio: 4 / 3;
    }
  }
</style>