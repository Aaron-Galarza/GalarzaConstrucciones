---
// Botón de WhatsApp reutilizable. El mensaje se pasa desde los mensajes
// centralizados de `lib/company.ts` para no duplicar textos en cada página.

import { whatsappURL } from '../lib/company';

interface Props {
  message: string;
  label?: string;
  variant?: 'solid' | 'ghost' | 'accent';
  /** Clases adicionales del contenedor (ej. "header-cta"). */
  class?: string;
}

const {
  message,
  label = 'Consultar mi proyecto',
  variant = 'solid',
  class: className,
} = Astro.props;

const variantClass =
  variant === 'ghost'
    ? 'btn btn--ghost'
    : variant === 'accent'
      ? 'btn btn--accent'
      : 'btn';
---

<a
  href={whatsappURL(message)}
  class:list={[variantClass, className]}
  target="_blank"
  rel="noopener"
>
  <slot>{label}</slot>
</a>
