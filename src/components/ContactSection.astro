---
import { COMPANY, CONTACT, whatsappURL } from '../lib/company';

interface Props {
  /** Encabezado de la sección (en la home se usa uno más corto). */
  heading?: string;
}

const { heading = 'Consultá por tu proyecto.' } = Astro.props;
---

<section class="section contact" id="contacto">
  <div class="shell">
    <header class="section-head">
      <p class="annotation">Contacto</p>
      <h2>{heading}</h2>
    </header>

    <div class="contact-grid">
      <div class="contact-info">
        <h3 class="contact-name">{COMPANY.name}</h3>
        <p class="contact-person small">
          {COMPANY.lawyer} · {COMPANY.profession}
        </p>

        <ul class="contact-list">
          <li>
            <span class="contact-label">Dirección</span>
            <a href={COMPANY.instagram.url} target="_blank" rel="noopener">
              {COMPANY.address.street}, {COMPANY.address.city},{' '}
              {COMPANY.address.province}
            </a>
          </li>
          <li>
            <span class="contact-label">Teléfono fijo</span>
            <a href={CONTACT.telLandline}>{COMPANY.phone.landline}</a>
          </li>
          <li>
            <span class="contact-label">Celular / WhatsApp</span>
            <a href={whatsappURL(CONTACT.whatsappMessage)} target="_blank" rel="noopener">
              {COMPANY.phone.mobile}
            </a>
          </li>
          <li>
            <span class="contact-label">Email</span>
            <a href={CONTACT.mailto}>{COMPANY.email}</a>
          </li>
          <li>
            <span class="contact-label">Instagram</span>
            <a href={COMPANY.instagram.url} target="_blank" rel="noopener">
              {COMPANY.instagram.handle}
            </a>
          </li>
        </ul>
      </div>

      <div class="contact-note">
        <h3 class="contact-note-title">Primero analizamos, después ejecutamos.</h3>
        <p>
          Contanos qué proyecto tenés: tipo de obra, localidad y qué problema o
          necesidad querés resolver. Con eso agendamos una evaluación real.
        </p>
        <p>
          Trabajamos en Resistencia, en toda la provincia del Chaco y en otras
          provincias según el proyecto.
        </p>
        <a href={whatsappURL(CONTACT.whatsappMessage)} class="btn" target="_blank" rel="noopener">
          Consultar mi proyecto
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
  }

  .contact-name {
    font-size: var(--text-2xl);
    margin-bottom: 0.2rem;
  }

  .contact-person {
    margin-bottom: var(--space-lg);
  }

  .contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .contact-list li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--space-sm);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-line);
    margin: 0;
    align-items: baseline;
  }

  .contact-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-cyan);
  }

  .contact-list a {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .contact-note {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-top: 3px solid var(--color-navy);
    padding: var(--space-lg);
  }

  .contact-note-title {
    font-size: 1.3rem;
  }

  .contact-note p {
    color: var(--color-muted);
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  /* Móvil: etiqueta sobre valor, para que el email no quede aplastado. */
  @media (max-width: 640px) {
    .contact-list li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>