---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { breadcrumbSchema, localBusinessSchema } from '../../lib/schema';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const schema = [
  localBusinessSchema(),
  breadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Blog', path: '/blog/' },
  ]),
];
---

<BaseLayout
  title="Blog técnico de construcción | Galarza Construcción"
  description="Artículos sobre grietas y fisuras, problemas de humedad, intervención de muros portantes y patologías de la construcción, escritos desde la experiencia de obra."
  path="/blog/"
  schemas={schema}
>
  <div class="shell page-content">
    <Breadcrumbs
      items={[
        { name: 'Inicio', path: '/' },
        { name: 'Blog', path: '/blog/' },
      ]}
    />
    <header class="page-head">
      <p class="annotation">Blog</p>
      <h1>Respuestas técnicas a preguntas de obra.</h1>
      <p class="lead">
        Contenido original escrito desde la experiencia real de construcción,
        para quienes tienen dudas concretas sobre patologías, estructura y
        decisiones de obra.
      </p>
    </header>

    <div class="posts-list">
      {
        posts.map((post) => (
          <article class="post-card card">
            <p class="post-meta small">
              {post.data.category} · {post.data.date.toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' })}
            </p>
            <h2 class="post-title">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="post-desc">{post.data.description}</p>
            <a href={`/blog/${post.id}/`} class="post-link">Leer el artículo</a>
          </article>
        ))
      }
    </div>
  </div>

  <CTASection message="Hola, leí los artículos técnicos del blog de Galarza Construcción y quiero consultar por un problema concreto. ¿Cómo coordino una consulta o una reunión para comentarles mi caso?" />
</BaseLayout>

<style>
  .page-content {
    padding-top: var(--space-lg);
  }

  .page-head {
    max-width: var(--container-narrow);
    margin-bottom: var(--space-lg);
  }

  .page-head .lead {
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-top: var(--space-sm);
  }

  .posts-list {
    display: grid;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .post-card {
    padding: var(--space-lg);
    border-left: 3px solid var(--color-navy);
  }

  .post-meta {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-sm);
  }

  .post-title {
    font-size: 1.4rem;
    margin-bottom: var(--space-sm);
  }

  .post-title a {
    color: var(--color-ink);
    text-decoration-color: var(--color-cyan);
  }

  .post-desc {
    color: var(--color-muted);
    max-width: 60ch;
  }

  .post-link {
    font-weight: 600;
    font-size: var(--text-sm);
  }
</style>