---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHeader from '../../components/PageHeader.astro';
import CTASection from '../../components/CTASection.astro';
import { localBusinessSchema } from '../../lib/schema';
import { breadcrumbTrail } from '../../lib/breadcrumbs';
import { WHATSAPP_MESSAGES } from '../../lib/company';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const crumbs = breadcrumbTrail([{ name: 'Blog', path: '/blog/' }]);

const schema = [localBusinessSchema(), crumbs.schema];
---

<BaseLayout
  title="Blog técnico de construcción | Galarza Construcción"
  description="Artículos sobre grietas y fisuras, problemas de humedad, intervención de muros portantes y patologías de la construcción, escritos desde la experiencia de obra."
  path="/blog/"
  schemas={schema}
>
  <div class="shell page-content">
    <Breadcrumbs items={crumbs.items} />
    <PageHeader
      annotation="Blog"
      title="Respuestas técnicas a preguntas de obra."
      lead="Contenido original escrito desde la experiencia real de construcción, para quienes tienen dudas concretas sobre patologías, estructura y decisiones de obra."
    />

    <div class="posts-list">
      {
        posts.map((post) => (
          <article class="post-card card">
            <p class="post-meta small">
              {post.data.category} · {post.data.date.toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' })}
            </p>
            <h2 class="post-title">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="post-desc">{post.data.description}</p>
            <a href={`/blog/${post.id}/`} class="post-link">Leer el artículo</a>
          </article>
        ))
      }
    </div>
  </div>

  <CTASection message={WHATSAPP_MESSAGES.blogList} />
</BaseLayout>

<style>
  .posts-list {
    display: grid;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .post-card {
    padding: var(--space-lg);
    border-left: 3px solid var(--color-navy);
  }

  .post-meta {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-sm);
  }

  .post-title {
    font-size: 1.4rem;
    margin-bottom: var(--space-sm);
  }

  .post-title a {
    color: var(--color-ink);
    text-decoration-color: var(--color-cyan);
  }

  .post-desc {
    color: var(--color-muted);
    max-width: 60ch;
  }

  .post-link {
    font-weight: 600;
    font-size: var(--text-sm);
  }
</style>