---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { articleSchema, breadcrumbSchema, localBusinessSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const schema = [
  articleSchema({
    title: post.data.title,
    description: post.data.description,
    date: post.data.date,
    updatedDate: post.data.updatedDate,
    path: `/blog/${post.id}/`,
    author: post.data.author,
  }),
  localBusinessSchema(),
  breadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Blog', path: '/blog/' },
    { name: post.data.title, path: `/blog/${post.id}/` },
  ]),
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={`/blog/${post.id}/`}
  type="article"
  image={post.data.image}
  schemas={schema}
>
  <div class="shell page-content">
    <Breadcrumbs
      items={[
        { name: 'Inicio', path: '/' },
        { name: 'Blog', path: '/blog/' },
        { name: post.data.title, path: `/blog/${post.id}/` },
      ]}
    />

    <article class="article">
      <header class="article-head">
        <p class="annotation">{post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p class="article-meta small">
          {post.data.author} ·{' '}
          {post.data.date.toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' })}
          {
            post.data.updatedDate && (
              <> · Actualizado {post.data.updatedDate.toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' })}</>
            )
          }
        </p>
      </header>

      {
        post.data.image && (
          <img
            src={post.data.image}
            alt={post.data.title}
            class="article-hero"
            width="1600"
            height="1200"
            loading="lazy"
            decoding="async"
          />
        )
      }

      <div class="prose">
        <Content />
      </div>

      <footer class="article-foot">
        {
          post.data.tags.length > 0 && (
            <ul class="tag-list">
              {
                post.data.tags.map((tag) => (
                  <li>{tag}</li>
                ))
              }
            </ul>
          )
        }
        <a href="/contacto/" class="btn">
          Consultar mi proyecto
        </a>
      </footer>
    </article>
  </div>

  <CTASection
    message={`Hola, llegué desde el artículo "${post.data.title}" del blog de Galarza Construcción y creo que tengo un problema similar. ¿Me orientan sobre cómo se hace la evaluación de estos casos o coordinamos una visita?`}
  />
</BaseLayout>

<style>
  .page-content {
    padding-top: var(--space-lg);
  }

  .article {
    max-width: var(--container-narrow);
    margin-bottom: var(--space-xl);
  }

  .article-head {
    margin-bottom: var(--space-lg);
  }

  .article-head h1 {
    font-size: var(--text-2xl);
  }

  .article-meta {
    margin-top: var(--space-sm);
  }

  .article-hero {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center;
    border: 1px solid var(--color-line);
    margin-bottom: var(--space-lg);
  }

  .prose {
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--color-ink);
  }

  .prose > * {
    max-width: 72ch;
  }

  .prose h2 {
    font-size: 1.35rem;
    margin-top: var(--space-lg);
  }

  .prose p:last-child {
    margin-bottom: 0;
  }

  .article-foot {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-line);
  }

  .tag-list {
    list-style: none;
    margin: 0 0 var(--space-md);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .tag-list li {
    font-size: var(--text-sm);
    color: var(--color-muted);
    border: 1px solid var(--color-line);
    padding: 0.3rem 0.8rem;
    border-radius: 2px;
    background: var(--color-surface);
  }
</style>