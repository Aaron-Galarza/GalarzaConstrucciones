---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada | Galarza Construcción"
  description="La página que buscás no existe. Volvé a la portada de Galarza Construcción."
  path="/404/"
  robots="noindex, follow"
>
  <section class="section">
    <div class="shell narrow">
      <p class="annotation">Error 404</p>
      <h1>La página que buscás no existe.</h1>
      <p class="lead">
        Puede que el enlace esté desactualizado o que la página se haya movido.
        Volvé al inicio o usá la navegación para encontrar lo que necesitás.
      </p>
      <a href="/" class="btn">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: var(--container-narrow);
  }

  .lead {
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-bottom: var(--space-lg);
  }
</style>