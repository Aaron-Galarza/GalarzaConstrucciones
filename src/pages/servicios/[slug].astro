---
// Página dinámica de servicio: una por cada entrada de la colección
// `servicios`. El contenido proviene del frontmatter + body markdown.

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTASection from '../../components/CTASection.astro';
import WorkGallery from '../../components/WorkGallery.astro';
import { serviceSchema, breadcrumbSchema, localBusinessSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const servicios = await getCollection('servicios');
  return servicios.map((servicio) => ({
    params: { slug: servicio.id },
    props: { servicio },
  }));
}

const { servicio } = Astro.props;
const { Content } = await render(servicio);

// Obras relacionadas, resueltas sobre la colección `obras`.
const obrasRelacionadas = (await getCollection('obras')).filter(
  (obra) => servicio.data.works.includes(obra.id),
);

const schema = [
  serviceSchema({
    title: servicio.data.title,
    description: servicio.data.summary,
    path: `/servicios/${servicio.id}/`,
  }),
  localBusinessSchema(),
  breadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Servicios', path: '/servicios/' },
    { name: servicio.data.title, path: `/servicios/${servicio.id}/` },
  ]),
];
---

<BaseLayout
  title={`${servicio.data.title} en Resistencia, Chaco | Galarza Construcción`}
  description={servicio.data.summary}
  path={`/servicios/${servicio.id}/`}
  schemas={schema}
>
  <div class="shell page-content">
    <Breadcrumbs
      items={[
        { name: 'Inicio', path: '/' },
        { name: 'Servicios', path: '/servicios/' },
        { name: servicio.data.title, path: `/servicios/${servicio.id}/` },
      ]}
    />

    <header class="page-head">
      <p class="annotation">Servicios</p>
      <h1>{servicio.data.title}</h1>
      <p class="lead">{servicio.data.summary}</p>
    </header>

    <div class="layout-grid">
      <article class="main-col">
        <section class="block">
          <h2>Sobre el servicio</h2>
          <div class="prose">
            <Content />
          </div>
        </section>

        <section class="block">
          <h2>Cuándo se necesita</h2>
          <p>{servicio.data.when}</p>
        </section>

        <section class="block">
          <h2>Problemas que resuelve</h2>
          <ul>
            {
              servicio.data.problems.map((p) => (
                <li>{p}</li>
              ))
            }
          </ul>
        </section>

        <section class="block">
          <h2>Qué incluye</h2>
          <ul>
            {
              servicio.data.includes.map((i) => (
                <li>{i}</li>
              ))
            }
          </ul>
        </section>

        {
          servicio.data.images.length > 0 && (
            <section class="block">
              <WorkGallery
                items={servicio.data.images}
                heading="Trabajos de referencia"
              />
            </section>
          )
        }

        {
          obrasRelacionadas.length > 0 && (
            <section class="block">
              <h2>Obras relacionadas</h2>
              <ul class="related-works">
                {
                  obrasRelacionadas.map((obra) => (
                    <li>
                      <a href={`/obras/${obra.id}/`}>
                        <strong>{obra.data.title}</strong>
                        <span class="small">
                          {obra.data.category} · {obra.data.location}
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </section>
          )
        }
      </article>

      <aside class="side-col">
        <div class="side-card">
          <h3>¿Querés avanzar con este servicio?</h3>
          <p class="small">
            Contanos tu caso y lo evaluamos: tipo de proyecto, localidad y qué
            necesitás resolver.
          </p>
          <a
            href="https://wa.me/549362154660649?text=Hola%2C%20quiero%20consultar%20por%20un%20proyecto"
            class="btn"
            target="_blank"
            rel="noopener"
          >
            Consultar mi proyecto
          </a>
          <a href="/contacto/" class="btn btn--ghost side-link">Ir a contacto</a>
        </div>
      </aside>
    </div>

    {
      servicio.data.faq.length > 0 && (
        <FAQSection items={servicio.data.faq} />
      )
    }
  </div>

  <CTASection />
</BaseLayout>

<style>
  .page-content {
    padding-top: var(--space-lg);
  }

  .page-head {
    max-width: var(--container-narrow);
    margin-bottom: var(--space-lg);
  }

  .page-head .lead {
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-top: var(--space-sm);
  }

  .layout-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: var(--space-xl);
    align-items: start;
  }

  .main-col {
    min-width: 0;
  }

  .block {
    margin-bottom: var(--space-xl);
  }

  .block h2 {
    font-size: 1.4rem;
    margin-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.5rem;
  }

  .block p:last-child {
    margin-bottom: 0;
  }

  .prose {
    max-width: 66ch;
    color: var(--color-muted);
  }

  .related-works {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
  }

  .related-works a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius);
  }

  .related-works a:hover {
    border-color: var(--color-navy);
  }

  .side-card {
    position: sticky;
    top: 100px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-top: 3px solid var(--color-navy);
    padding: var(--space-lg);
  }

  .side-card .btn {
    width: 100%;
    margin-bottom: var(--space-sm);
  }

  .side-link {
    width: 100%;
  }

  @media (max-width: 900px) {
    .layout-grid {
      grid-template-columns: 1fr;
    }

    .side-card {
      position: static;
    }
  }
</style>