---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHeader from '../../components/PageHeader.astro';
import BlueprintCard from '../../components/BlueprintCard.astro';
import CTASection from '../../components/CTASection.astro';
import { itemListSchema } from '../../lib/schema';
import { breadcrumbTrail } from '../../lib/breadcrumbs';
import { obraCover } from '../../lib/obras';
import { COMPANY, WHATSAPP_MESSAGES } from '../../lib/company';

const obras = (await getCollection('obras')).sort(
  (a, b) => a.data.order - b.data.order,
);

const crumbs = breadcrumbTrail([{ name: 'Obras', path: '/obras/' }]);

const schema = [
  crumbs.schema,
  itemListSchema(
    'Obras de Galarza Construcción',
    obras.map((obra) => ({
      name: obra.data.title,
      path: `/obras/${obra.id}/`,
    })),
  ),
];
---

<BaseLayout
  title="Obras en Resistencia y el Chaco | Galarza Construcción"
  description={`Portfolio de obras reales de ${COMPANY.name} en Resistencia y el Chaco: obras institucionales, infraestructura, comerciales y residenciales ejecutadas y supervisadas.`}
  path="/obras/"
  schemas={schema}
>
  <div class="shell page-content">
    <Breadcrumbs items={crumbs.items} />
    <PageHeader
      annotation="Obras"
      title="Proyectos reales, ejecutados y supervisados."
      lead="Una selección de obras que muestran escala, infraestructura, resolución estructural y adaptación al entorno."
    />

    <div class="works-grid">
      {
        obras.map((obra, i) => {
          const cover = obraCover(obra);
          return (
            <BlueprintCard
              code={`O-${String(i + 1).padStart(2, '0')}`}
              title={obra.data.title}
              href={`/obras/${obra.id}/`}
              category={obra.data.category}
              location={obra.data.location}
              image={cover?.src}
              imageAlt={cover?.alt}
            />
          );
        })
      }
    </div>
  </div>

  <CTASection message={WHATSAPP_MESSAGES.worksList} />
</BaseLayout>

<style>
  .works-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  @media (max-width: 720px) {
    .works-grid {
      grid-template-columns: 1fr;
    }
  }
</style>