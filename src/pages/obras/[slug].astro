---
// Página dinámica de obra: relato visual que alterna texto e imágenes
// (antes, durante y después) + servicios involucrados.

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHeader from '../../components/PageHeader.astro';
import CTASection from '../../components/CTASection.astro';
import WorkStory from '../../components/WorkStory.astro';
import { workSchema } from '../../lib/schema';
import { breadcrumbTrail } from '../../lib/breadcrumbs';
import { WHATSAPP_MESSAGES } from '../../lib/company';
import { obraCover } from '../../lib/obras';

export async function getStaticPaths() {
  const obras = await getCollection('obras');
  return obras.map((obra) => ({
    params: { slug: obra.id },
    props: { obra },
  }));
}

const { obra } = Astro.props;

const serviciosRelacionados = (await getCollection('servicios')).filter(
  (s) => obra.data.services.includes(s.id),
);

const isCase = obra.data.caseStudy;
const cover = obraCover(obra);

const crumbs = breadcrumbTrail([
  { name: 'Obras', path: '/obras/' },
  { name: obra.data.title, path: `/obras/${obra.id}/` },
]);

const schema = [
  workSchema({
    title: obra.data.title,
    description: obra.data.description,
    path: `/obras/${obra.id}/`,
    location: obra.data.location,
    image: cover?.src,
  }),
  crumbs.schema,
];
---

<BaseLayout
  title={`${obra.data.title} | Obras de Galarza Construcción`}
  description={obra.data.summary}
  path={`/obras/${obra.id}/`}
  image={cover?.src}
  imageAlt={cover?.alt}
  schemas={schema}
>
  <div class="shell page-content">
    <Breadcrumbs items={crumbs.items} />

    <PageHeader
      annotation={isCase ? 'Caso de estudio' : undefined}
      title={obra.data.title}
      meta={`${obra.data.category} · ${obra.data.location}, ${obra.data.province}${obra.data.period ? ` · ${obra.data.period}` : ''}`}
      lead={obra.data.summary}
    />

    <WorkStory blocks={obra.data.story} />

    {
      serviciosRelacionados.length > 0 && (
        <section class="services-block">
          <h2>Servicios involucrados</h2>
          <ul class="service-tags">
            {serviciosRelacionados.map((s) => (
              <li>
                <a href={`/servicios/${s.id}/`}>{s.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  <CTASection message={WHATSAPP_MESSAGES.work(obra.data.title)} />
</BaseLayout>

<style>
  .services-block {
    margin-bottom: var(--space-xl);
  }

  .services-block h2 {
    font-size: 1.4rem;
    margin-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.5rem;
  }

  .service-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .service-tags a {
    display: inline-block;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 0.55rem 1rem;
    text-decoration: none;
    color: var(--color-navy);
    border-radius: 2px;
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .service-tags a:hover {
    border-color: var(--color-navy);
  }
</style>
