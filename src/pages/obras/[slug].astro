---
// Página dinámica de obra: detalle completo (descripción, problema, solución,
// resultado) + formato de caso de estudio cuando la obra lo declara.

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHeader from '../../components/PageHeader.astro';
import CTASection from '../../components/CTASection.astro';
import WorkGallery from '../../components/WorkGallery.astro';
import { workSchema, localBusinessSchema } from '../../lib/schema';
import { breadcrumbTrail } from '../../lib/breadcrumbs';
import { whatsappURL } from '../../lib/company';

export async function getStaticPaths() {
  const obras = await getCollection('obras');
  return obras.map((obra) => ({
    params: { slug: obra.id },
    props: { obra },
  }));
}

const { obra } = Astro.props;

const serviciosRelacionados = (await getCollection('servicios')).filter(
  (s) => obra.data.services.includes(s.id),
);

const isCase = obra.data.caseStudy;

// Galería: las imágenes sin etapa van al registro general; las que tienen
// etapa se muestran junto a su bloque del proceso (antes, durante, después).
const stageItems = (stage: 'antes' | 'durante' | 'despues') =>
  obra.data.gallery.filter((item) => item.stage === stage);

const gallery = obra.data.gallery.filter((item) => !item.stage);

const crumbs = breadcrumbTrail([
  { name: 'Obras', path: '/obras/' },
  { name: obra.data.title, path: `/obras/${obra.id}/` },
]);

const schema = [
  workSchema({
    title: obra.data.title,
    description: obra.data.summary,
    path: `/obras/${obra.id}/`,
    location: obra.data.location,
    image: obra.data.gallery[0]?.src,
  }),
  localBusinessSchema(),
  crumbs.schema,
];
---

<BaseLayout
  title={`${obra.data.title} | Obras de Galarza Construcción`}
  description={obra.data.summary}
  path={`/obras/${obra.id}/`}
  image={obra.data.gallery[0]?.src}
  schemas={schema}
>
  <div class="shell page-content">
    <Breadcrumbs items={crumbs.items} />

    <PageHeader
      annotation={isCase ? 'Caso de estudio' : undefined}
      title={obra.data.title}
      meta={`${obra.data.category} · ${obra.data.location}, ${obra.data.province}${obra.data.period ? ` · ${obra.data.period}` : ''}`}
      lead={obra.data.description}
    />

    {
      gallery.length > 0 && (
        <WorkGallery
          items={gallery}
          heading="Registro fotográfico de la obra"
        />
      )
    }

    <div class="layout-grid">
      <article class="case-body">
        <section class="block">
          <h2>Antes</h2>
          <p>{obra.data.before}</p>
          {
            stageItems('antes').length > 0 && (
              <WorkGallery items={stageItems('antes')} heading="" />
            )
          }
        </section>

        <section class="block">
          <h2>Durante</h2>
          <p>{obra.data.during}</p>
          {
            stageItems('durante').length > 0 && (
              <WorkGallery items={stageItems('durante')} heading="" />
            )
          }
        </section>

        <section class="block">
          <h2>Después</h2>
          <p>{obra.data.after}</p>
          {
            stageItems('despues').length > 0 && (
              <WorkGallery items={stageItems('despues')} heading="" />
            )
          }
        </section>

        {
          serviciosRelacionados.length > 0 && (
            <section class="block">
              <h2>Servicios involucrados</h2>
              <ul class="service-tags">
                {
                  serviciosRelacionados.map((s) => (
                    <li>
                      <a href={`/servicios/${s.id}/`}>{s.data.title}</a>
                    </li>
                  ))
                }
              </ul>
            </section>
          )
        }
      </article>

      <aside class="side-col">
        <div class="side-card">
          <h3>¿Tenés un proyecto similar?</h3>
          <p class="small">
            Si tu obra plantea un desafío de estructura, remodelación o
            construcción, contanos el caso y lo evaluamos.
          </p>
          <a
            href={whatsappURL(
              `Hola, vi la obra ${obra.data.title} en la web de Galarza Construcción y me gustaría hacer un proyecto similar. ¿Me cuentan cómo lo encararían y cómo coordinamos una llamada o reunión?`,
            )}
            class="btn"
            target="_blank"
            rel="noopener"
          >
            Consultar mi proyecto
          </a>
          <a href="/obras/" class="btn btn--ghost side-link">Ver más obras</a>
        </div>
      </aside>
    </div>
  </div>

  <CTASection
    message={`Hola, vi la obra ${obra.data.title} en la web de Galarza Construcción y me gustaría hacer un proyecto similar. ¿Me cuentan cómo lo encararían y cómo coordinamos una llamada o reunión?`}
  />
</BaseLayout>

<style>
  .layout-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: var(--space-xl);
    align-items: start;
  }

  .case-body {
    min-width: 0;
  }

  .block {
    margin-bottom: var(--space-xl);
  }

  .block h2 {
    font-size: 1.4rem;
    margin-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.5rem;
  }

  .block p {
    max-width: 64ch;
  }

  .service-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .service-tags a {
    display: inline-block;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 0.55rem 1rem;
    text-decoration: none;
    color: var(--color-navy);
    border-radius: 2px;
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .service-tags a:hover {
    border-color: var(--color-navy);
  }

  .side-card {
    position: sticky;
    top: 100px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-top: 3px solid var(--color-navy);
    padding: var(--space-lg);
  }

  .side-card .btn {
    width: 100%;
    margin-bottom: var(--space-sm);
  }

  .side-link {
    width: 100%;
  }

  @media (max-width: 900px) {
    .layout-grid {
      grid-template-columns: 1fr;
    }

    .side-card {
      position: static;
    }
  }
</style>